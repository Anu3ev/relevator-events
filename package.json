{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs server/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.12.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
